    <Story name="replay">
      <Act name="replay">
        <ManeuverGroup maximumExecutionCount="1" name="mg_hero">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="hero"/>
          </Actors>
          <Maneuver name="m_hero">
            <Event name="follow_hero" priority="overwrite">
              <Action name="trajectory_hero">
